table 'Medidas - Inadimplência'
	lineageTag: a3fc303e-97ff-4362-9d70-96e4bf22c279

	measure 'Inadimplência - Valor Absoluto' = SUM(fact_delinquency_snapshot[valor_boleto])
		lineageTag: 1b16aab1-54f0-43dc-8336-93a5cadac890

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inadimplência - Última Data Snapshot' = MAX(fact_delinquency_snapshot[dt_referencia])
		formatString: General Date
		lineageTag: acf4ab4e-9854-48ed-bbd9-ba4e337a97cf

	measure 'Inadimplência - Valor Atual' = ```
			
			VAR UltimaData = 
			    MAX(fact_delinquency_snapshot[dt_referencia])
			RETURN
			CALCULATE(
			    'Medidas - Inadimplência'[Inadimplência - Valor Absoluto],
			    fact_delinquency_snapshot[dt_referencia] = UltimaData
			)
			```
		lineageTag: 54c2498b-1b75-4b49-b9b7-51b438fda34d

	measure 'Inadimplência - Qtd Boletos Atual' = ```
			
			VAR UltimaData = 
			    MAX(fact_delinquency_snapshot[dt_referencia])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fact_delinquency_snapshot[codigo_boleto]),
			    fact_delinquency_snapshot[dt_referencia] = UltimaData
			)
			```
		formatString: 0
		lineageTag: 9a629368-6c2f-4504-aee8-3a5064f47d10

	measure 'Inadimplência - Ticket Médio' =
			
			DIVIDE(
			    [Inadimplência - Valor Atual],
			    [Inadimplência - Qtd Boletos Atual]
			)
		lineageTag: 38e7a561-4847-4425-b9cc-580067b13e34

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inadimplência - Valor Mês Anterior' = ```
			
			CALCULATE(  
			    [Inadimplência - Valor Atual],
			    PREVIOUSMONTH(dim_calendar[Data])
			)
			```
		lineageTag: 05a534b4-8968-4fe3-aea0-c19c34c67b63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inadimplência - Dif Mês Atual x Anterior' =
			
			[Inadimplência - Valor Atual] - [Inadimplência - Valor Mês Anterior]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: f8e8857a-f1b5-4880-b7a8-e0386049895c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Inadimplência - Var % Mês Atual x Anterior' =
			
			DIVIDE(
			    [Inadimplência - Dif Mês Atual x Anterior],
			    [Inadimplência - Valor Mês Anterior]
			)
		lineageTag: 9cdef09c-cff9-4942-afab-a227304303c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Inadimplência - Qtd Boletos Fechamento' =
			
			VAR UltimaData =
			    MAX ( fact_delinquency_snapshot[dt_referencia] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( fact_delinquency_snapshot[codigo_boleto] ),
			    fact_delinquency_snapshot[dt_referencia] = UltimaData
			)
		formatString: 0
		lineageTag: edd21696-6bd1-44ab-ba42-b854e06b83c5

	measure 'Inadimplência - % Sobre Emitido' =
			DIVIDE(
			    [Inadimplência - Valor Atual],
			    [Receita Emitida],
			    0
			)
		lineageTag: 524907ce-220b-4fb3-9c6a-31c858289ecd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Z
		isHidden
		formatString: 0
