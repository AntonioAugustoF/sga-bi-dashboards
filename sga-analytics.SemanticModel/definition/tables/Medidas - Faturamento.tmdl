	measure 'Receita Emitida - Média Móvel 3M' = ```
			
			VAR _periodo = 
			    DATESINPERIOD(dim_calendar[Data], MAX(dim_calendar[Data]), -3, MONTH)
			VAR _tabela_mensal = 
			    ADDCOLUMNS(
			        VALUES(dim_calendar[MesAno]),
			        "@receita", [Receita Emitida]
			    )
			RETURN
			    AVERAGEX(
			        FILTER(_tabela_mensal, [MesAno] IN _periodo),
			        [@receita]
			    )
			```
		formatString: 0
		lineageTag: 181253ca-adb4-4dd5-8aad-73e3879b5e7d

	measure 'Receita Recebida - Média Móvel 3M' = ```
			
