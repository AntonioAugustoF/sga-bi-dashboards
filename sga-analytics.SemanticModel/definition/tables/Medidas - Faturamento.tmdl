table 'Medidas - Faturamento'
	lineageTag: 3d6bdfe1-3782-41f8-ae37-f31c34c17fb2

	measure 'Receita Recebida' =
			
			CALCULATE(
			    SUM(fact_invoices[valor_pagamento]),
			    USERELATIONSHIP(fact_invoices[data_pagamento], dim_calendar[Data])
			)
		lineageTag: 9c769c26-9403-45a4-af8b-ff198d7d5a9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - MTD' =
			
			VAR DataCorte =
			    CALCULATE(
			        MAX(fact_invoices[data_pagamento]),
			        ALL(fact_invoices)
			    )
			
			VAR DiaCorte = DAY(DataCorte)
			
			VAR DataContexto = MAX(dim_calendar[Data])
			
			VAR InicioMesContexto =
			    DATE(YEAR(DataContexto), MONTH(DataContexto), 1)
			
			VAR FimMesContexto =
			    EOMONTH(DataContexto, 0)
			
			VAR FimMTDContexto =
			    DATE(
			        YEAR(FimMesContexto),
			        MONTH(FimMesContexto),
			        MIN(DiaCorte, DAY(FimMesContexto))
			    )
			
			RETURN
			CALCULATE(
			    [Receita Recebida],
			    DATESBETWEEN(
			        dim_calendar[Data],
			        InicioMesContexto,
			        FimMTDContexto
			    )
			)
		lineageTag: c22143ff-6ddc-48e9-820f-d795fd99fe78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - Mês Anterior' =
			CALCULATE(
			    [Receita Recebida],
			    PREVIOUSMONTH(dim_calendar[Data])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: c7d1460c-c5fb-4059-ae8c-cd23a8849b02

	measure 'Receita Recebida - MTD Mês Anterior' =
			
			VAR DataCorte =
			    CALCULATE(
			        MAX(fact_invoices[data_pagamento]),
			        ALL(fact_invoices)
			    )
			
			VAR DiaCorte = DAY(DataCorte)
			
			VAR DataContexto = MAX(dim_calendar[Data])
			VAR DataMesAnterior = EOMONTH(DataContexto, -1)
			
			VAR InicioMesAnterior =
			    DATE(YEAR(DataMesAnterior), MONTH(DataMesAnterior), 1)
			
			VAR FimMesAnterior =
			    EOMONTH(DataMesAnterior, 0)
			
			VAR FimMTDMesAnterior =
			    DATE(
			        YEAR(FimMesAnterior),
			        MONTH(FimMesAnterior),
			        MIN(DiaCorte, DAY(FimMesAnterior))
			    )
			
			RETURN
			CALCULATE(
			    [Receita Recebida],
			    DATESBETWEEN(
			        dim_calendar[Data],
			        InicioMesAnterior,
			        FimMTDMesAnterior
			    )
			)
		lineageTag: b1d0c32f-c9d9-40ad-88ad-dbf523dce41f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - Var Abs MA' =
			
			[Receita Recebida - MTD] - [Receita Recebida - MTD Mês Anterior]
		lineageTag: 2a148df1-39ff-45bd-a5e3-22d967fbaf2c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - Var % MA' =
			
			DIVIDE(
			    [Receita Recebida - Var Abs MA],
			    [Receita Recebida - MTD Mês Anterior]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6032e926-1ee9-46ab-9aa4-ff7f965fc0a2

	measure 'Receita Recebida - YTD' =
			
			TOTALYTD(
			    [Receita Recebida],
			    dim_calendar[Data]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 51e7fb36-ab6a-441a-bd50-9d2865448358

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Recebida - Ano Anterior' =
			
			CALCULATE(
			    [Receita Recebida],
			    SAMEPERIODLASTYEAR(dim_calendar[Data])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7006213c-e6f8-4436-a376-be66493a9d1e

	measure 'Receita Recebida - Var % AA' =
			
			DIVIDE(
			    [Receita Recebida] - [Receita Recebida - Ano Anterior],
			    [Receita Recebida - Ano Anterior]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e66156ae-c7c1-4088-84be-b0c9c55e8ed2

	measure 'Receita Recebida - Var Abs AA' =
			
			[Receita Recebida] - [Receita Recebida - Ano Anterior]
		lineageTag: 67ab6474-508b-4d26-83b4-3c66310fa7bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - Qtd Boletos' =
			CALCULATE(
			    DISTINCTCOUNT(fact_invoices[codigo_boleto]),
			    fact_invoices[descricao_situacao_boleto] IN {"baixado", "baixado c/ pendência"}
			)
		formatString: 0
		lineageTag: a24d7212-7b14-4aac-a3b3-265fe4df07b0

	measure 'Receita Recebida - Ticket Médio' =
			DIVIDE(
