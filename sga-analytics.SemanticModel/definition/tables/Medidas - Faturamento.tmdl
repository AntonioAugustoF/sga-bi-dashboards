table 'Medidas - Faturamento'
	lineageTag: 3d6bdfe1-3782-41f8-ae37-f31c34c17fb2

	measure 'Receita Recebida' =
			
			CALCULATE(
			    SUM(fact_invoices[valor_pagamento]),
			    USERELATIONSHIP(fact_invoices[data_pagamento], dim_calendar[Data])
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01 Receita\Recebida
		lineageTag: 9c769c26-9403-45a4-af8b-ff198d7d5a9f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Recebida - Qtd Boletos' =
			CALCULATE(
			    DISTINCTCOUNT(fact_invoices[codigo_boleto]),
			    fact_invoices[descricao_situacao_boleto] IN {"baixado", "baixado c/ pendência"}
			)
		formatString: 0
		displayFolder: 01 Receita\Recebida
		lineageTag: a24d7212-7b14-4aac-a3b3-265fe4df07b0

	measure 'Receita Recebida - Ticket Médio' =
			DIVIDE(
			    [Receita Recebida],
			    [Receita Recebida - Qtd Boletos]
			)
		displayFolder: 01 Receita\Recebida
		lineageTag: 3ab0e8d0-c53d-499a-8c05-974080310f3f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Emitida' =
			CALCULATE(
			    SUM(fact_invoices[valor_boleto]),
			    fact_invoices[descricao_situacao_boleto] <> "excluido"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 01 Receita\Emitida
		lineageTag: 90faf48b-54cd-46af-bab0-b259466df664

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Receita Emitida - Qtd Boletos' =
			CALCULATE(
			    DISTINCTCOUNT(fact_invoices[codigo_boleto]),
			    fact_invoices[descricao_situacao_boleto] <> "excluido"
			)
		formatString: 0
		displayFolder: 01 Receita\Emitida
		lineageTag: c817fd7a-522d-4033-82de-7c75852f8bc8

	measure 'Receita Emitida - Ticket Médio' =
			DIVIDE(
			    [Receita Emitida],
			    [Receita Emitida - Qtd Boletos]
			)
		displayFolder: 01 Receita\Emitida
		lineageTag: 3a1921a5-aee0-4d2f-ab18-ec0b3b6af553

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Receita recebida acumulada no ano corrente (reusa o calc item Período[YTD]).
	measure 'Meta • Realizado YTD' =
			CALCULATE(
			    [Receita Recebida],
			    'Período'[Período] = "YTD"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 02 Meta
		lineageTag: 2a7c1f04-8b21-4d59-9e3a-1c6f0b0a5d11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Baseline: faturamento do ano-calendário anterior ao selecionado. Remove filtros de
	/// dim_calendar e reaplica só o ano, para não ser zerado pelo slicer de Ano da página.
	measure 'Meta • Base Anual' =
			VAR _AnoRef = SELECTEDVALUE( dim_calendar[Ano], YEAR( MAX( dim_calendar[Data] ) ) )
			VAR _AnoAnterior = _AnoRef - 1
			RETURN
			    CALCULATE(
			        [Receita Recebida],
			        REMOVEFILTERS( dim_calendar ),
			        dim_calendar[Ano] = _AnoAnterior
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 02 Meta
		lineageTag: 3b8d2f15-9c32-4e6a-8f4b-2d7f1c1b6e22

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Meta do ano: ano anterior completo + crescimento ajustável pelo What-If.
	measure 'Meta • Alvo Anual' = [Meta • Base Anual] * ( 1 + [% Crescimento Meta Valor] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 02 Meta
		lineageTag: 4c9e3026-ad43-4f7b-9a5c-3e802d2c7f33

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Progresso rumo à meta anual: quanto do alvo já foi realizado no ano.
	measure 'Meta • % Atingimento' =
			DIVIDE(
			    [Meta • Realizado YTD],
			    [Meta • Alvo Anual]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Meta
		lineageTag: 5d0f4137-be54-4a8c-8b6d-4f913e3d8044

	/// Parte restante da barra de progresso (a fatia cinza). Não passa de 100%.
	measure 'Meta • % Restante' =
			MAX(
			    0,
			    1 - [Meta • % Atingimento]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Meta
		lineageTag: 6e105248-cf65-4b9d-9c7e-50a24f4e9155

	/// Faturamento RECEBIDO por consultor. Rateia o valor_pagamento real de cada boleto pela
	/// qtd de veículos (mesma lógica do pipeline p/ o emitido). SUMX sobre a bridge é necessário
	/// porque o rateio é linha-a-linha; USERELATIONSHIP alinha à data de pagamento, como Receita
	/// Recebida — somado por todos os consultores, reconcilia com [Receita Recebida].
	/// ATRIBUIÇÃO: consultor ATUAL. A bridge liga-se a dim_vehicles_current (uma linha por veículo),
	/// não à dim_vehicles SCD2 — cuja codigo_veiculo deixou de ser única e causava fan-out/duplicação.
	/// Efeito colateral aceito: transferir um veículo de carteira reescreve o histórico do ranking.
	/// Para atribuição point-in-time, a bridge precisa carregar sk_vehicle da data do pagamento
	/// (mudança no sga-api-pipeline) — ver WORKLOG.md.
	measure 'Faturamento Recebido Rateado' =
			CALCULATE(
			    SUMX(
			        bridge_invoices_vehicles,
			        DIVIDE(
			            RELATED( fact_invoices[valor_pagamento] ),
			            bridge_invoices_vehicles[qtd_veiculos_boleto]
			        )
			    ),
			    USERELATIONSHIP( fact_invoices[data_pagamento], dim_calendar[Data] )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 03 Rateio por Consultor
		lineageTag: 9a1b7c50-3d68-4e21-b7a4-6c1f2e0a4b55

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Faturamento EMITIDO por consultor (lente de qualidade/gap; guardado, não usado no card atual).
	/// Usa valor_rateado (rateio do valor_boleto já materializado na bridge pelo pipeline) e exclui
	/// boletos "excluido" para reconciliar com [Receita Emitida].
	measure 'Faturamento Emitido Rateado' =
			CALCULATE(
			    SUM( bridge_invoices_vehicles[valor_rateado] ),
			    KEEPFILTERS( fact_invoices[descricao_situacao_boleto] <> "excluido" )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 03 Rateio por Consultor
		lineageTag: 8b2c6d41-4e79-4f32-a8b5-7d2e3f1b5c66

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Z
		formatString: 0
		lineageTag: 3a42025c-a142-4ef1-b9d9-2652dbc007b5
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Z]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas - Faturamento' = calculated
		mode: import
		source = Row("Z", BLANK())

	annotation PBI_Id = f0ce93e0223c4ad583399bec5521f93c

