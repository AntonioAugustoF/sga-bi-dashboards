	measure 'Receita Emitida - Var % YTD AA' =
			
			VAR _atual = [Receita Emitida - YTD]
			VAR _anterior = [Receita Emitida - YTD AA]
			RETURN
			    DIVIDE (_atual - _anterior, _anterior)
		lineageTag: 86d8ade8-ce2b-4238-aef6-db45aa3b6ddc

