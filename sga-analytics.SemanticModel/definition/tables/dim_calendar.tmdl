table dim_calendar
	lineageTag: fe33cf22-311f-4834-892c-470f47d72951
	dataCategory: Time

	column Data
		isKey
		formatString: Short Date
		lineageTag: 5c8e359d-69b7-4eaf-96f4-271849c634f5
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Mês = FORMAT(dim_calendar[Data], "mmmm")
		lineageTag: e43e503a-ac4e-4514-8139-541e33c492ed
		summarizeBy: none
		sortByColumn: 'Nº Mês'

		annotation SummarizationSetBy = Automatic

	column 'Nº Mês' = MONTH(dim_calendar[Data])
		formatString: 0
		lineageTag: 64625ada-f348-4be7-967f-bc3988a51064
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Início Mês' = STARTOFMONTH(dim_calendar[Data])
		formatString: Long Date
		lineageTag: c9b1e58c-14da-43d4-b63f-3d69b4155abd
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Trimestre = QUARTER(dim_calendar[Data])
		formatString: 0
		lineageTag: 18ee398a-1654-49df-a01f-b1e347495bae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Semestre = IF(dim_calendar[Nº Mês] <= 6, 1, 2)
		formatString: 0
		lineageTag: 7d09b34a-afed-4b1b-bba8-e70abb48f321
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Ano = YEAR(dim_calendar[Data])
		formatString: 0
		lineageTag: 7d8fe03b-57a2-4147-b314-7f45932984a3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MesAno = FORMAT(dim_calendar[Início Mês], "mmm/yyyy")
		lineageTag: 4b115287-a758-4fb0-932d-8312b8f24bb1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Data Vigente?' =
			IF(
			    dim_calendar[Data]<=MAX(fact_invoices[data_pagamento]),
			    "Sim",
			    "Não"
			)
		lineageTag: 19bcada2-edf4-46cd-b8a5-f6a2cfbbffe0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_calendar = calculated
		mode: import
		source =
				CALENDAR(
				    DATE(YEAR(MIN(fact_invoices[data_pagamento])), 1, 1),
				    DATE(YEAR(MAX((fact_invoices[data_pagamento]))), 12, 31)
				)

	annotation PBI_Id = 61e426aff23b44249ca4429869e372b8

