table 'Time Intelligence'
	lineageTag: 0ed943e1-e2c3-4ea0-9b0d-b1d9e7ec3ea4

	calculationGroup

		calculationItem 'Valor Atual' = SELECTEDMEASURE()

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem MTD =
				VAR _UltimaData =
				    CALCULATE(
				        MAX(dim_calendar[Data]),
				        FILTER(ALL(dim_calendar), NOT ISBLANK(SELECTEDMEASURE()))
				    )
				VAR _DiaCorte = DAY(_UltimaData)
				VAR _DataContexto = MAX(dim_calendar[Data])
				VAR _InicioMes = DATE(YEAR(_DataContexto), MONTH(_DataContexto), 1)
				VAR _FimMes = EOMONTH(_DataContexto, 0)
				VAR _FimMTD = DATE(YEAR(_FimMes), MONTH(_FimMes), MIN(_DiaCorte, DAY(_FimMes)))
				RETURN
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATESBETWEEN(dim_calendar[Data], _InicioMes, _FimMTD)
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'MTD Mês Anterior' =
				VAR _UltimaData =
				    CALCULATE(
				        MAX(dim_calendar[Data]),
				        FILTER(ALL(dim_calendar), NOT ISBLANK(SELECTEDMEASURE()))
				    )
				VAR _DiaCorte = DAY(_UltimaData)
				VAR _DataContexto = MAX(dim_calendar[Data])
				VAR _DataMesAnterior = EOMONTH(_DataContexto, -1)
				VAR _InicioMesAnterior = DATE(YEAR(_DataMesAnterior), MONTH(_DataMesAnterior), 1)
				VAR _FimMesAnterior = EOMONTH(_DataMesAnterior, 0)
				VAR _FimMTDAnterior = DATE(YEAR(_FimMesAnterior), MONTH(_FimMesAnterior), MIN(_DiaCorte, DAY(_FimMesAnterior)))
				RETURN
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATESBETWEEN(dim_calendar[Data], _InicioMesAnterior, _FimMTDAnterior)
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Mês Anterior' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    PREVIOUSMONTH(dim_calendar[Data])
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem QTD =
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATESQTD(dim_calendar[Data])
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem YTD =
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATESYTD(dim_calendar[Data])
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Ano Anterior' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    SAMEPERIODLASTYEAR(dim_calendar[Data])
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'YTD Ano Anterior' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    'Time Intelligence'[Cálculo] = "YTD",
				    SAMEPERIODLASTYEAR(dim_calendar[Data])
				)

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Var Abs Mês Anterior' =
				CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "MTD")
				- CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "MTD Mês Anterior")

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Var % Mês Anterior' =
				DIVIDE(
				    CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Var Abs Mês Anterior"),
				    CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "MTD Mês Anterior")
				)

			formatStringDefinition = "0.00%;-0.00%;0.00%"

		calculationItem 'Var Abs Ano Anterior' =
				CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Valor Atual")
				- CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Ano Anterior")

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem 'Var % Ano Anterior' =
				DIVIDE(
				    CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Var Abs Ano Anterior"),
				    CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Ano Anterior")
				)

			formatStringDefinition = "0.00%;-0.00%;0.00%"

		calculationItem 'Média Móvel 3M' =
				VAR _periodo =
				    DATESINPERIOD(dim_calendar[Data], MAX(dim_calendar[Data]), -3, MONTH)
				VAR _tabelaMensal =
				    ADDCOLUMNS(
				        CALCULATETABLE(VALUES(dim_calendar[MesAno]), _periodo),
				        "@valor", CALCULATE(SELECTEDMEASURE(), 'Time Intelligence'[Cálculo] = "Valor Atual")
				    )
				RETURN
				    AVERAGEX(_tabelaMensal, [@valor])

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

	column Cálculo
		dataType: string
		lineageTag: da4acea1-5ce4-4255-acf2-0b3d3b5acf53
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		lineageTag: c919da08-61f7-4327-ae5a-d9826458ef7f
		sourceColumn: Ordinal

